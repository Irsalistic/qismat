# Optional settings — copy to .env and fill in what you use.
# The tool works fully without any of these.

# --- Ollama (local, free) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Google Gemini (free tier available) ---
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI / GPT ---
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Telegram alerts (recommended) ---
# 1. Message @BotFather to create a bot and copy the token
# 2. Message your bot, then open:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 3. Copy your chat id
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# --- WhatsApp alerts via Twilio ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+92xxxxxxxxxx

# --- Email alerts ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=app_password
# ALERT_EMAIL_FROM=you@gmail.com
# ALERT_EMAIL_TO=you@gmail.com

# --- Generic webhook (optional) ---
# NOTIFY_WEBHOOK_URL=https://example.com/prize-bond-webhook
